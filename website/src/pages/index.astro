---
import Base from '../layouts/Base.astro';
import { Code } from 'astro:components';
import ArchDiagram from '../components/ArchDiagram.astro';
import { highlightJava } from '../lib/snippets';

const javaExample = `RandomAccessFile file = new RandomAccessFile("archive.7z", "r");
try (IInArchive archive = SevenZip.openInArchive(null, // autodetect format
        new RandomAccessFileInStream(file))) {

    for (ISimpleInArchiveItem item : archive.getSimpleInterface().getArchiveItems()) {
        System.out.println(item.getPath() + "  (" + item.getSize() + " bytes)");
    }
}`;

const V = '26.03-2.4';
const G = 'net.sf.sevenzipjbinding';
const gradleKts = `implementation("${G}:sevenzipjbinding:${V}")
implementation("${G}:sevenzipjbinding-all-platforms:${V}")`;
const gradleGroovy = `implementation '${G}:sevenzipjbinding:${V}'
implementation '${G}:sevenzipjbinding-all-platforms:${V}'`;
const sbtDep = `libraryDependencies += "${G}" % "sevenzipjbinding" % "${V}"
libraryDependencies += "${G}" % "sevenzipjbinding-all-platforms" % "${V}"`;
const ivyDep = `<dependency org="${G}" name="sevenzipjbinding" rev="${V}"/>
<dependency org="${G}" name="sevenzipjbinding-all-platforms" rev="${V}"/>`;
const javaExampleHtml = await highlightJava(javaExample);
const mavenDep = `<dependency>
    <groupId>net.sf.sevenzipjbinding</groupId>
    <artifactId>sevenzipjbinding</artifactId>
    <version>26.03-2.4</version>
</dependency>
<dependency>
    <groupId>net.sf.sevenzipjbinding</groupId>
    <artifactId>sevenzipjbinding-all-platforms</artifactId>
    <version>26.03-2.4</version>
</dependency>`;
---
<Base title="7-Zip-JBinding — the 7-Zip archive engine for Java">

  <!-- ============================================== HERO -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="badges">
          <span class="badge"><span class="dot"></span> v26.03-2.4 · all platforms green</span>
          <span class="badge">LGPL-2.1</span>
          <span class="badge warm">Java 8+</span>
        </div>
        <h1>The 7-Zip engine,<br /><span class="brand-text">bound to Java.</span></h1>
        <p class="hero-sub">
          Extract <b>20+ archive formats</b> — 7z, ZIP, RAR, TAR, XZ and more — and create
          7z, ZIP, TAR, GZip, BZip2 &amp; XZ, with the real 7-Zip engine and native performance.
          One small library, every platform, no external tools.
          All I/O is <b>callback-driven</b>: run fully in memory, stream from any
          source — even a remote archive fetched piece by piece — and
          <a href="#callbacks">abort at any time</a>.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#quickstart">Get started</a>
          <a class="btn btn-ghost" href="https://github.com/borisbrodski/sevenzipjbinding">
            View on GitHub
          </a>
        </div>
        <div class="hero-facts">
          <div><b>12</b><span>platform builds</span></div>
          <div><b>8845</b><span>JUnit tests</span></div>
          <div><b>26.03</b><span>7-Zip engine</span></div>
          <div><b>2007</b><span>maintained since</span></div>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <img class="art7 art7-dark" src="/img/hero-7cup.jpg" alt="" />
        <img class="art7 art7-light" src="/img/hero-7cup-bright.jpg" alt="" />
      </div>
    </div>
  </section>

  <hr class="sep" />

  <!-- ============================================== FEATURES -->
  <section class="section" id="features">
    <div class="container">
      <div class="kicker">Why 7-Zip-JBinding</div>
      <h2>Everything the 7-Zip engine can do — as a Java API</h2>
      <p class="lead">Not a wrapper around an external binary: the engine is compiled into a small
        native library, driven through JNI by a clean Java interface.</p>
      <div class="grid3">
        <div class="card"><h3><span class="ico">📦</span>20+ formats, one API</h3>
          <p>7z, ZIP, RAR/RAR5, TAR, GZip, BZip2, XZ, ISO, CAB, NTFS, … — with archive-format
          auto-detection, password support and multi-volume archives.</p></div>
        <div class="card"><h3><span class="ico">⚡</span>Native performance</h3>
          <p>The original 7-Zip 26.03 C/C++ engine, running in-process. Stream-based:
          extract from and compress to memory, files or your own I/O callbacks.</p></div>
        <div class="card"><h3><span class="ico">🗜️</span>Create &amp; update archives</h3>
          <p>Write 7z, ZIP, TAR, GZip, BZip2 and XZ. Update existing archives in place —
          add, replace and remove items without repacking everything.</p></div>
        <div class="card"><h3><span class="ico warm">☕</span>One jar, every platform</h3>
          <p>Windows (x86, x64 &amp; ARM64), Linux (glibc &amp; musl/Alpine, x86 &amp; ARM v5–v8) and macOS
          (universal: Intel + Apple Silicon). Runtime auto-detection picks the right
          native library.</p></div>
        <div class="card"><h3><span class="ico">🔒</span>Encryption support</h3>
          <p>Open and create password-protected archives, including 7z header encryption
          and encrypted RAR5 archives.</p></div>
        <div class="card"><h3><span class="ico">✅</span>Tested like it matters</h3>
          <p>8845 JUnit tests, run on every supported platform — real VMs, real ARM
          hardware, both with the per-platform jar and the all-platforms jar.</p></div>
      </div>
    </div>
  </section>

  <hr class="sep" />

  <!-- ============================================== HOW IT WORKS -->
  <section class="section" id="how">
    <div class="container">
      <div class="kicker">How it works</div>
      <h2>The real engine, one JNI hop away</h2>
      <p class="lead">Your code talks to a small Java API. Behind it, a single native library
        contains the C++ binding layer and the unmodified 7-Zip engine — no external processes,
        no temp executables, no shelling out.</p>
      <ArchDiagram />
    </div>
  </section>

  <hr class="sep" />

  <!-- ============================================== CALLBACK-DRIVEN I/O -->
  <section class="section" id="callbacks">
    <div class="container">
      <div class="kicker">Callback-driven I/O</div>
      <h2>Your callbacks <em>are</em> the I/O layer</h2>
      <p class="lead">Extraction and compression never touch the disk unless you want them to.
        The engine asks for bytes — your code decides where they come from and where they go.
        That unlocks patterns that are impossible with an external unzip tool:</p>

      <div class="cap-grid">
        <div class="cap"><b>Fully in-memory</b><span>compress &amp; extract byte arrays — no files, no temp dirs</span></div>
        <div class="cap"><b>Any data source</b><span>implement one stream interface: file, memory, network, database, S3, …</span></div>
        <div class="cap"><b>Random access, on demand</b><span>the engine reads only what it needs — serve just those byte ranges</span></div>
        <div class="cap"><b>Partial extraction</b><span>pull a few items out of a huge archive that is never stored locally</span></div>
        <div class="cap"><b>Remote archives</b><span>list &amp; extract while downloading only the required parts</span></div>
        <div class="cap"><b>Abort any time</b><span>cancel a running operation from a callback — cleanly</span></div>
        <div class="cap"><b>Progress reporting</b><span>fine-grained progress for UIs and job monitoring</span></div>
        <div class="cap"><b>Multi-volume on demand</b><span>supply volumes as they appear — even wait for one to be mounted</span></div>
        <div class="cap"><b>Smart caching</b><span>cache hot regions of large archives in your stream layer</span></div>
        <div class="cap"><b>Password callbacks</b><span>asked only when actually needed — per archive or per item</span></div>
      </div>

      <p class="cap-example">
        <b>Example:</b> extract two files from a 40&nbsp;GB remote backup — your
        <code>IInStream</code> serves the engine's reads via HTTP range requests, downloading
        megabytes instead of gigabytes. <a href="/snippets/">See the snippets →</a>
      </p>
    </div>
  </section>

  <hr class="sep" />

  <!-- ============================================== QUICK START -->
  <section class="section" id="quickstart">
    <div class="container">
      <div class="kicker">Quick start</div>
      <h2>Two dependencies. Five lines of code.</h2>
      <p class="lead">Add the API jar and the native-libraries jar from Maven Central.
        The right native library is detected and loaded at runtime.</p>
      <div class="grid2">
        <div class="codebox" data-deptabs>
          <div class="codebox-head deps-head">
            <span class="dep-tabs" role="tablist">
              <button class="dep-tab active" data-tab="maven" role="tab">Maven</button>
              <button class="dep-tab" data-tab="gradle-kts" role="tab">Gradle (Kotlin)</button>
              <button class="dep-tab" data-tab="gradle" role="tab">Gradle (Groovy)</button>
              <button class="dep-tab" data-tab="sbt" role="tab">SBT</button>
              <button class="dep-tab" data-tab="ivy" role="tab">Ivy</button>
            </span>
            <button class="copy-btn" data-copy>Copy</button>
          </div>
          <div class="dep-panel active" data-panel="maven">
            <Code code={mavenDep} lang="xml" themes={{ light: "github-light", dark: "one-dark-pro" }} />
          </div>
          <div class="dep-panel" data-panel="gradle-kts">
            <Code code={gradleKts} lang="kotlin" themes={{ light: "github-light", dark: "one-dark-pro" }} />
          </div>
          <div class="dep-panel" data-panel="gradle">
            <Code code={gradleGroovy} lang="groovy" themes={{ light: "github-light", dark: "one-dark-pro" }} />
          </div>
          <div class="dep-panel" data-panel="sbt">
            <Code code={sbtDep} lang="scala" themes={{ light: "github-light", dark: "one-dark-pro" }} />
          </div>
          <div class="dep-panel" data-panel="ivy">
            <Code code={ivyDep} lang="xml" themes={{ light: "github-light", dark: "one-dark-pro" }} />
          </div>
        </div>
        <div class="codebox">
          <div class="codebox-head"><span>ListArchive.java</span>
            <button class="copy-btn" data-copy>Copy</button></div>
          <div class="jd-code" set:html={javaExampleHtml} />
        </div>
      </div>
      <p class="after-code">Want more? Every example on this site is a <b>real, tested program</b> —
        its output is verified by the test suite on every release.
        <a href="/snippets/">Browse the code snippets →</a></p>
    </div>
  </section>

  <hr class="sep" />

  <!-- ============================================== PLATFORMS -->
  <section class="section" id="platforms">
    <div class="container">
      <div class="kicker">Platforms</div>
      <h2>12 native builds, verified on real systems</h2>
      <p class="lead">Ship <code>-all-platforms</code> and forget about it — or pick a single
        platform jar to keep your artifact small.</p>
      <div class="platgrid">
        <div class="plat"><b>Windows</b><span>x86 · amd64 · arm64</span></div>
        <div class="plat"><b>Linux (glibc)</b><span>i386 · amd64 · ARM v5/v6/v7 · ARM64</span></div>
        <div class="plat"><b>Linux (musl / Alpine)</b><span>amd64 · ARMv7 · ARM64</span></div>
        <div class="plat"><b>macOS</b><span>universal — Intel + Apple Silicon</span></div>
      </div>
      <div class="plat-note">
        <span class="badge"><span class="dot"></span> every build: 18/18 test bundles green</span>
        <span class="badge">runtime detection: OS · arch · ARM level · glibc/musl</span>
      </div>
    </div>
  </section>

  <hr class="sep" />

  <!-- ============================================== RELEASE -->
  <section class="section-tight" id="release">
    <div class="container">
      <div class="release-strip card">
        <div>
          <div class="kicker" style="margin-bottom:4px">Latest release</div>
          <h3 style="font-size:1.3rem; margin:0 0 6px">26.03-2.4 <span class="rel-date">· September 2026</span></h3>
          <p style="margin:0">7-Zip engine 26.03 (up from 23.01) · resolves CVE-2024-11477 · Windows on Arm (arm64)
            · Java 8 baseline · Apple Silicon · musl/Alpine builds · runtime platform auto-detection</p>
        </div>
        <div class="release-cta">
          <div class="release-actions">
            <a class="btn btn-primary" href="https://github.com/borisbrodski/sevenzipjbinding/releases/latest">Download</a>
            <a class="btn btn-ghost" href="https://github.com/borisbrodski/sevenzipjbinding/blob/master/ChangeLog">Release notes</a>
          </div>
          <div class="release-alt">Also on <a href="https://sourceforge.net/projects/sevenzipjbind/files/7-Zip-JBinding/">SourceForge</a> (mirror)</div>
        </div>
      </div>
      <div class="sec-note">
        <span class="sec-ico">✅</span>
        <div>
          <b>CVE-2024-11477 resolved</b> (7-Zip Zstandard decompression, HIGH). Fixed as of
          <b>26.03-2.4</b>: the bundled 7-Zip engine now postdates the upstream fix released in
          7-Zip&nbsp;24.07. No known security issues in the current release.
          <a href="https://github.com/borisbrodski/sevenzipjbinding/issues/72">Details: issue #72</a>.
        </div>
      </div>
    </div>
  </section>

  <style>
    /* hero */
    .hero { position: relative; overflow: hidden; }
    :root[data-theme='light'] .hero-glow { display: none; }
    .hero-glow {
      position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(600px 320px at 78% 30%, rgba(40,152,248,.14), transparent 65%),
        radial-gradient(500px 300px at 85% 75%, rgba(232,120,40,.10), transparent 60%),
        radial-gradient(700px 400px at 15% 10%, rgba(88,72,248,.08), transparent 60%);
    }
    .hero-grid {
      position: relative; display: grid; grid-template-columns: 1.25fr .75fr;
      gap: 40px; align-items: center; padding-top: 84px; padding-bottom: 84px;
    }
    .badges { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 22px; }
    .hero-sub { font-size: 1.13rem; max-width: 540px; margin: 18px 0 28px; }
    .hero-cta { display: flex; gap: 14px; margin-bottom: 40px; }
    .hero-facts { display: flex; gap: 40px; flex-wrap: wrap; }
    .hero-facts div { display: flex; flex-direction: column; }
    .hero-facts b { font-size: 1.45rem; font-weight: 750; letter-spacing: -.02em; }
    .hero-facts span { font-size: .82rem; color: var(--text-3); }

    .hero-art { position: relative; height: 380px; }
    .hero-art .art7 {
      position: absolute; right: 30px; top: -10px; width: 330px;
      /* rectangular soft-edge mask: tiny top fade (bg-only margin), gentle sides/bottom */
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 9%, #000 91%, transparent 100%),
                          linear-gradient(to bottom, transparent 0, #000 4%, #000 91%, transparent 100%);
      -webkit-mask-composite: source-in;
              mask-image: linear-gradient(to right, transparent 0, #000 9%, #000 91%, transparent 100%),
                          linear-gradient(to bottom, transparent 0, #000 4%, #000 91%, transparent 100%);
              mask-composite: intersect;
      filter: drop-shadow(0 18px 44px rgba(232,120,40,.18));
    }
    .art7-light { display: none; }
    :root[data-theme='light'] .art7-dark { display: none; }
    :root[data-theme='light'] .art7-light { display: block; }
    :root[data-theme='light'] .hero-art .art7 { mix-blend-mode: multiply; filter: drop-shadow(0 14px 34px rgba(201,100,26,.22)); }
    @media (max-width: 900px) {
      .hero-grid { grid-template-columns: 1fr; }
      .hero-art { display: none; }
    }

    /* dependency tabs */
    .deps-head { padding: 0 10px 0 4px; }
    .dep-tabs { display: flex; gap: 2px; overflow-x: auto; overflow-y: hidden; scrollbar-width: none; }
    .dep-tabs::-webkit-scrollbar { display: none; }
    .dep-tab {
      appearance: none; background: transparent; border: 0; cursor: pointer;
      color: var(--text-3); font: 600 .8rem var(--font-sans);
      padding: 10px 12px; border-bottom: 2px solid transparent; margin-bottom: -1px;
      white-space: nowrap; transition: color .15s;
    }
    .dep-tab:hover { color: var(--text); }
    .dep-tab.active { color: var(--text); border-image: var(--brand-grad) 1; border-bottom: 2px solid; }
    .dep-panel { display: none; }
    .dep-panel.active { display: block; }

    /* callback capability chips */
    .cap-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px 18px; max-width: 900px; }
    @media (max-width: 800px) { .cap-grid { grid-template-columns: 1fr; } }
    .cap {
      display: flex; align-items: baseline; gap: 10px;
      padding: 10px 14px; border: 1px solid var(--border); border-radius: 10px;
      background: var(--surface);
    }
    .cap b { font-size: .92rem; white-space: nowrap; color: var(--text); }
    .cap b::before { content: '▸ '; background: var(--brand-grad); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .cap span { font-size: .86rem; color: var(--text-3); }
    .cap-example { margin-top: 24px; font-size: .95rem; max-width: 760px; }
    .cap-example code { background: var(--surface-2); border: 1px solid var(--border); border-radius: 5px; padding: 1px 6px; font-size: .85em; }
    #callbacks h2 em { font-style: italic; }

    /* grids */
    .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-items: start; }
    @media (max-width: 900px) { .grid3, .grid2 { grid-template-columns: 1fr; } }
    .after-code { margin-top: 22px; font-size: .95rem; }
    .codebox .jd-code pre { margin: 0; padding: 16px 18px; overflow-x: auto; background: transparent !important; font-size: .86rem; }
    .jd-code a.jd-link { color: inherit; text-decoration: none; border-bottom: 1px dotted var(--border-strong); }
    .jd-code a.jd-link:hover, .jd-code a.jd-link:hover * { color: var(--blue) !important; border-bottom-color: var(--blue); }

    /* platforms */
    .platgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 22px; }
    @media (max-width: 900px) { .platgrid { grid-template-columns: repeat(2, 1fr); } }
    .plat {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 18px 20px; display: flex; flex-direction: column; gap: 4px;
    }
    .plat b { font-size: 1rem; }
    .plat span { color: var(--text-3); font-size: .85rem; }
    .plat-note { display: flex; gap: 10px; flex-wrap: wrap; }

    /* release strip */
    .release-strip { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .release-cta { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
    .release-actions { display: flex; gap: 12px; }
    .release-alt { font-size: .82rem; color: var(--text-3); }
    .release-alt a { color: var(--text-2); text-decoration: underline; }
    @media (max-width: 700px) { .release-cta { align-items: flex-start; } }
    .rel-date { color: var(--text-3); font-weight: 400; font-size: .95rem; }
    .sec-note {
      display: flex; gap: 12px; margin-top: 18px; padding: 14px 16px;
      border: 1px solid rgba(232,120,40,.35); border-radius: var(--radius);
      background: linear-gradient(140deg, rgba(232,120,40,.08), transparent);
      font-size: .9rem; color: var(--text-2);
    }
    .sec-note b { color: var(--text); }
    .sec-ico { flex: 0 0 auto; }
  </style>

  <script>
    document.querySelectorAll('[data-deptabs]').forEach((box) => {
      box.querySelectorAll('.dep-tab[data-tab]').forEach((tab) => {
        tab.addEventListener('click', () => {
          box.querySelectorAll('.dep-tab').forEach((t) => t.classList.remove('active'));
          box.querySelectorAll('.dep-panel').forEach((p) => p.classList.remove('active'));
          tab.classList.add('active');
          box.querySelector(`[data-panel="${tab.getAttribute('data-tab')}"]`)?.classList.add('active');
        });
      });
    });
    document.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const box = btn.closest('.codebox');
        const pre = box?.querySelector('.dep-panel.active pre') ?? box?.querySelector('pre');
        if (!pre) return;
        navigator.clipboard.writeText(pre.textContent ?? '');
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = 'Copy'), 1600);
      });
    });
  </script>
</Base>
